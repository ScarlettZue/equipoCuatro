<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- HU 1.0 Ventana Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.univalle.dogapp.view.fragment.LoginFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_login">
        <!-- Saca el login de la pila: atrás desde el Home lleva al escritorio (HU 2.0, criterio 1). -->
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- HU 2.0 Home Administrador de Citas -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.univalle.dogapp.view.fragment.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_addAppointmentFragment"
            app:destination="@id/addAppointmentFragment" />
        <action
            android:id="@+id/action_homeFragment_to_appointmentDetailsFragment"
            app:destination="@id/appointmentDetailsFragment" />
    </fragment>

    <!-- HU 3.0 Ventana Nueva Cita -->
    <fragment
        android:id="@+id/addAppointmentFragment"
        android:name="com.univalle.dogapp.view.fragment.AddAppointmentFragment"
        android:label="@string/title_add_appointment"
        tools:layout="@layout/fragment_add_appointment">
        <!-- Al guardar vuelve al Home (nueva instancia, así recarga la lista). -->
        <action
            android:id="@+id/action_addAppointmentFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- HU 4.0 Ventana Detalle de la Cita -->
    <fragment
        android:id="@+id/appointmentDetailsFragment"
        android:name="com.univalle.dogapp.view.fragment.AppointmentDetailsFragment"
        android:label="@string/title_appointment_details"
        tools:layout="@layout/fragment_appointment_details">
        <action
            android:id="@+id/action_appointmentDetailsFragment_to_editAppointmentFragment"
            app:destination="@id/editAppointmentFragment" />
        <!-- Al eliminar vuelve al Home (nueva instancia, así recarga la lista). -->
        <action
            android:id="@+id/action_appointmentDetailsFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- HU 5.0 Ventana Editar Cita -->
    <fragment
        android:id="@+id/editAppointmentFragment"
        android:name="com.univalle.dogapp.view.fragment.EditAppointmentFragment"
        android:label="@string/title_edit_appointment"
        tools:layout="@layout/fragment_edit_appointment">
        <!-- Al editar vuelve al Home (nueva instancia, así recarga la lista). -->
        <action
            android:id="@+id/action_editAppointmentFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>


</navigation>
